<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP so the app can call http://DROPLET_IP:8080 when built with --dart-define=API_BASE_URL.
     For production, prefer HTTPS and a proper domain (no cleartext needed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
